-#[cfg(all(target_arch = "aarch64", target_feature = "neon"))]
-mod primitives_neon {
-    /// NEON intrinsics are `#[target_feature]` and thus unsafe; the helpers
-    /// below are pure register ops with no memory safety preconditions, so
-    /// each wraps itself in an `unsafe` block.
-    mod raw {
-        use core::arch::aarch64::*;
-        pub unsafe fn load128(src: *const u8, i: usize) -> uint8x16_t {
-            vld1q_u8(src.add(i))
-        }
-        pub fn veq(v: uint8x16_t, c: u8) -> uint8x16_t {
-            unsafe { vceqq_u8(v, vdupq_n_u8(c)) }
-        }
-        pub fn mm(v: uint8x16_t) -> u16 {
-            // Input bytes are 0x00/0xFF. The low/high 64-bit halves go
-            // through GPR SWAR multiplies independently (bits 0-7 / 8-15);
-            // byte order within each half maps directly to bit order, so no
-            // deinterleave is needed.
-            unsafe {
-                let halves = vreinterpretq_u64_u8(v);
-                let lo64: u64 = vgetq_lane_u64(halves, 0);
-                let hi64: u64 = vgetq_lane_u64(halves, 1);
-                const SWAR: u64 = 0x0102_0408_1020_4080;
-                const ONES: u64 = 0x0101_0101_0101_0101;
-                let lo = ((lo64 & ONES).wrapping_mul(SWAR)) >> 56;
-                let hi = ((hi64 & ONES).wrapping_mul(SWAR)) >> 56;
-                (lo as u16) | ((hi as u16) << 8)
-            }
-        }
-    }
-    pub use raw::*;
-}
