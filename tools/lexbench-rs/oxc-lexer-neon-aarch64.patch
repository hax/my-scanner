+        i += 1;
+    }
+    n
+}
+
+#[inline]
+pub unsafe fn find4(src: *const u8, n: usize, mut i: usize, a: u8, b: u8, c: u8, d: u8) -> usize {
+    while i + 16 <= n {
+        let v = load128(src, i);
+        let m = mm(vorrq_u8(
+            vorrq_u8(veq(v, a), veq(v, b)),
+            vorrq_u8(veq(v, c), veq(v, d)),
+        ));
+        if m != 0 {
+            return i + m.trailing_zeros() as usize;
+        }
+        i += 16;
