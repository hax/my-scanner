+use core::arch::aarch64::*;
+
+use super::super::chunk::{load128, mm, veq};
+
+/// OR-fold of byte-equality results, associated as a tree.
+macro_rules! vor {
+    ($a:expr) => { $a };
+    ($a:expr, $b:expr) => {{
+        use core::arch::aarch64::vorrq_u8;
+        unsafe { vorrq_u8($a, $b) }
+    }};
+    ($a:expr, $b:expr, $($rest:expr),+) => {{
+        use core::arch::aarch64::vorrq_u8;
+        unsafe { vorrq_u8(vor!($a, $b), vor!($($rest),+)) }
+    }};
+}
+pub(super) use vor;
+
+macro_rules! define_find_function {
+    ($(#[$attr:meta])* $name:ident: $($needle:expr),+ $(,)?) => {
+        $(#[$attr])*
+        #[inline]
+        pub unsafe fn $name(src: *const u8, n: usize, mut i: usize) -> usize {
+            use super::super::chunk::{load128, mm, veq};
+            use super::aarch64::vor;
+
+            while i + 16 <= n {
+                let v = load128(src, i);
+                let m = mm(vor!($(veq(v, $needle)),+));
+                if m != 0 {
+                    return i + m.trailing_zeros() as usize;
+                }
+                i += 16;
+            }
+            while i < n {
+                let c = *src.add(i);
+                if $(c == $needle)||+ {
+                    return i;
+                }
+                i += 1;
+            }
+            n
+        }
+    };
+}
