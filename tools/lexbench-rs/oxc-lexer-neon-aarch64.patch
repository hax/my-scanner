+use core::arch::aarch64::*;
+
+use crate::{tables::Tables, token::tk};
+
+use super::super::chunk::{load128, mm, veq};
+
+#[inline(always)]
+fn dup(c: u8) -> uint8x16_t {
+    // SAFETY: pure register op.
+    unsafe { vdupq_n_u8(c) }
+}
+
+#[inline(always)]
+unsafe fn tbl2way(lo_lut: &[u8; 16], hi_lut: &[u8; 16], v: uint8x16_t, vn: uint8x16_t, vh: uint8x16_t) -> uint8x16_t {
+    // SAFETY: caller guarantees readable src; LUTs are 16-byte arrays.
+    unsafe {
+        vandq_u8(
+            vqtbl1q_u8(vld1q_u8(lo_lut.as_ptr()), vn),
+            vqtbl1q_u8(vld1q_u8(hi_lut.as_ptr()), vh),
+        )
+    }
+}
+
+#[inline(always)]
+fn not0(x: uint8x16_t) -> uint8x16_t {
+    // x != 0 per lane, as 0x00/0xFF
+    // SAFETY: pure register ops.
+    unsafe { vmvnq_u8(vceqzq_u8(x)) }
+}
+
+/// The merged LUT variants differ only in the keyword-initial bits; the
+/// selection happens once, outside the loop.
+pub(super) unsafe fn classify_impl(
+    t: &Tables,
+    ts: bool,
+    src: *const u8,
+    n: usize,
+    word: *mut u64,
+    st: *mut u64,
+    kwinit: *mut u64,
+    opch: *mut u64,
+    digit: *mut u64,
+    dot: *mut u64,
+    misc: *mut u64,
+    kind: *mut u8,
+) {
+    let mrg_lo = if ts { &t.mrg_lo_ts } else { &t.mrg_lo };
+    let mrg_hi = &t.mrg_hi;
+    let mut cw: u64 = 0;
+    let mut cs: u64 = 0;
+    let mut i = 0usize;
+    let mut b = 0usize;
+    let nb_ceil = n.div_ceil(64);
+    // SAFETY: vld1q of 16-byte static arrays.
+    let (wb_lo, wb_hi, mrg_lo_v, mrg_hi_v) = unsafe {
+        (
+            vld1q_u8(t.wb_lo.as_ptr()),
+            vld1q_u8(t.wb_hi.as_ptr()),
+            vld1q_u8(mrg_lo.as_ptr()),
+            vld1q_u8(mrg_hi.as_ptr()),
+        )
+    };
+    let v_ff = dup(0xff);
+    let v_00 = dup(0);
+    let v_3f = dup(0x3f);
+    let v_3c = dup(0x3c);
+    let v_c0 = dup(0xc0);
+    let v_02 = dup(0x02);
+    let v_80m = dup(0x80);
+    let v_10 = dup(0x10);
+    let v_03 = dup(0x03);
+    let v_0f = dup(0x0f);
+    let v_20 = dup(0x20);
+    let v_80m = dup(0x80);
+    let v_10 = dup(0x10);
+    let v_inv = dup(tk!(Invalid) as u8);
+    let v_ws = dup(tk!(Whitespace) as u8);
+    let v_ident = dup(tk!(Ident) as u8);
+    let v_num = dup(tk!(Number) as u8);
+    // SAFETY: vld1q of 16-byte static arrays.
+    let (ph_a, ph_b, ph_t0, ph_t1) = unsafe {
+        (
+            vld1q_u8(crate::tables::PH_A.as_ptr()),
+            vld1q_u8(crate::tables::PH_B.as_ptr()),
+            vld1q_u8(crate::tables::PH_T0.as_ptr()),
+            vld1q_u8(crate::tables::PH_T1.as_ptr()),
+        )
+    };
+    while b < nb_ceil {
+        let mut wordm: u64 = 0;
+        let mut wsm: u64 = 0;
+        let mut digitm: u64 = 0;
+        let mut miscm: u64 = 0;
+        let mut kwt: u64 = 0;
+        let mut opt: u64 = 0;
+        let mut dtt: u64 = 0;
+        for seg in 0..4 {
+            let off = i + seg * 16;
+            // SAFETY: overreads land in the caller-guaranteed zeroed PAD.
+            let v = unsafe { load128(src, off) };
+            let vn = vandq_u8(v, v_0f);
+            let vh = vshrq_n_u8(v, 4);
+            let wb = tbl2way(&t.wb_lo, &t.wb_hi, v, vn, vh);
+            let mg = tbl2way(mrg_lo, mrg_hi, v, vn, vh);
+            // Non-ASCII bytes count as identifier chars in `word` and are
+            // folded into `misc` so `misc_pre` can re-classify Unicode
+            // whitespace (signed < 0 == unsigned >= 0x80).
+            let na = unsafe { vcgtq_s8(vreinterpretq_s8_u8(v_00), vreinterpretq_s8_u8(v)) };
+            let word_b = vorrq_u8(vmvnq_u8(vceqq_u8(vandq_u8(wb, v_3f), v_00)), na);
+            let ws_b = vmvnq_u8(vceqq_u8(vandq_u8(wb, v_c0), v_00));
+            let digit_b = not0(vandq_u8(wb, v_02));
+            // oxc mrg 表的位面按 high-nibble 行拆分（见 tables.rs
+            // merged_selfcheck）：opch = 0x3c、dot = 0x80、kwinit = 0x03
+            let dot_b = not0(vandq_u8(mg, v_80m));
+            let opch_b = vorrq_u8(not0(vandq_u8(mg, v_3c)), dot_b);
+            let misc_b = vorrq_u8(
+                vorrq_u8(unsafe { veq(v, b'#') }, unsafe { veq(v, b'\\') }),
+                na,
+            );
+            let sh = (seg * 16) as u32;
+            wordm |= (mm(word_b) as u64) << sh;
+            wsm |= (mm(ws_b) as u64) << sh;
+            digitm |= (mm(digit_b) as u64) << sh;
+            miscm |= (mm(misc_b) as u64) << sh;
+            kwt |= (mm(not0(vandq_u8(mg, v_03))) as u64) << sh;
+            opt |= (mm(opch_b) as u64) << sh;
+            dtt |= (mm(dot_b) as u64) << sh;
+
+            // kind: single-byte punct via the punct1 PH-hash LUTs, then
+            // whitespace / ident / number overrides (mirrors vpunct1).
+            // SAFETY: pure register ops.
+            let hash = unsafe { veorq_u8(vqtbl1q_u8(ph_a, vn), vqtbl1q_u8(ph_b, vh)) };
+            let hn2 = vandq_u8(hash, v_0f);
+            // SAFETY: pure register ops.
+            let (o0, o1) = unsafe { (vqtbl1q_u8(ph_t0, hn2), vqtbl1q_u8(ph_t1, hn2)) };
+// bit4 of h selects T1. VBSL blends per-BIT, so the selector
+// must be expanded to per-byte 0x00/0xFF (VPBLENDV reads only
+// each byte's MSB, so AVX2 gets away with a bare <<3 that leaks
+// h's bit5 into the next byte's low bit).
+            let sel = unsafe {
+                vnegq_s8(vreinterpretq_s8_u8(vshrq_n_u8(vandq_u8(hash, v_10), 4)))
+            };
+            // SAFETY: pure register ops.
+            let mut k = unsafe { vbslq_u8(vreinterpretq_u8_s8(sel), o1, o0) };
+            let ctl = unsafe { vcgtq_s8(vreinterpretq_s8_u8(v_20), vreinterpretq_s8_u8(v)) };
+            k = unsafe { vbslq_u8(ctl, v_inv, k) };
+            k = unsafe { vbslq_u8(ws_b, v_ws, k) };
+            k = unsafe { vbslq_u8(word_b, v_ident, k) };
+            k = unsafe { vbslq_u8(digit_b, v_num, k) };
+            // SAFETY: `off..off+16` is in-bounds for kind (len ceil to 64).
+            unsafe {
+                vst1q_u8(kind.add(off), k);
+            }
+            let _ = (v_ff, v_00);
+        }
+        *word.add(b) = wordm;
+        *st.add(b) = (wsm & !((wsm << 1) | cs)) | (wordm & !((wordm << 1) | cw)) | (!wsm & !wordm);
+        cs = wsm >> 63;
+        cw = wordm >> 63;
+        *word.add(b) = wordm;
+        *digit.add(b) = digitm;
+        *misc.add(b) = miscm;
+        *kwinit.add(b) = kwt;
+        *opch.add(b) = opt;
+        *dot.add(b) = dtt;
+        i += 64;
+        b += 1;
+    }
+    // Mask the overread positions [n, ceil) out of the last block's bitmaps.
+    let rem = n & 63;
+    if rem != 0 {
+        let last = nb_ceil - 1;
+        let m = (1u64 << rem) - 1;
+        *word.add(last) &= m;
+        *st.add(last) &= m;
+        *kwinit.add(last) &= m;
+        *opch.add(last) &= m;
+        *digit.add(last) &= m;
+        *dot.add(last) &= m;
+        *misc.add(last) &= m;
+    }
+}
