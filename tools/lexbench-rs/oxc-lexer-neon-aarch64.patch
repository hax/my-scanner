+use core::arch::aarch64::*;
+
+use oxc_span::Span;
+
+use crate::{
+    lanes::Lanes,
+    tables::Tables,
+    token::{is_trivia_byte, tk},
+};
+
+use super::super::chunk::{eqm, load128};
+
+use super::common::{emit_value, invalid_diags};
+
+/// NEON twin of `compress/avx2.rs::compress_blocks`: per 16-byte segment of
+/// the st bitmap, the pair LUTs produce a control vector where byte j holds
+/// the offset of the j-th set bit (or 0x80 padding). VQTBL zero-fills on
+/// 0x80 just like PSHUFB, so the same LUTs drive both the position expand
+/// (widened to u32) and the kind gather.
+pub(super) unsafe fn compress_blocks(
+    t: &Tables,
+    st: *const u64,
+    kind: *const u8,
+    b0: usize,
+    b1: usize,
+    starts: *mut u32,
+    kinds: *mut u8,
+) -> usize {
+    let lut0z = t.pair_luts.lut0z.as_ptr().cast::<u8>();
+    let lutpad = t.pair_luts.lutpad.as_ptr().cast::<u8>();
+    let mut m = 0usize;
+    for b in b0..b1 {
+        let mword = *st.add(b);
+        if mword == 0 {
+            continue;
+        }
+        let base = b * 64;
+        let o0: u32 = 0;
+        let o1 = o0 + (mword & 0xffff).count_ones();
+        let o2 = o1 + ((mword >> 16) & 0xffff).count_ones();
+        let o3 = o2 + ((mword >> 32) & 0xffff).count_ones();
+        let o4 = o3 + (mword >> 48).count_ones();
+        for p in 0..4usize {
+            let sub0 = ((mword >> (16 * p)) & 0xff) as usize;
+            let sub1 = ((mword >> (16 * p + 8)) & 0xff) as usize;
+            let pc0 = sub0.count_ones() as usize;
+            // SAFETY: LUT rows are in-bounds for sub0/sub1; kind reads stay
+            // within the 64-byte block; the o-offsets index the stage
+            // buffers which the caller sized via STAGE_CAP.
+            unsafe {
+                let row0 = vld1_u8(lut0z.add(sub0 * 8));
+                let row1 = vld1q_u8(lutpad.add(sub1 * 32 + 8 - pc0));
+                let ctrl = vorrq_u8(vcombine_u8(row0, vdup_n_u8(0)), row1);
+                // SAFETY: kind row of the 64-byte block is in-bounds.
+                let kw = unsafe { load128(kind.add(base + 16 * p), 0) };
+                let out = m + match p {
+                    0 => o0,
+                    1 => o1,
+                    2 => o2,
+                    _ => o3,
+                } as usize;
+                // Widen ctrl bytes to u32 in 4-byte groups and add the
+                // segment base: ctrl byte j holds the offset 0..15 within
+                // segment p, so all 16 share base + 16*p.
+                let bv = vdupq_n_u32((base + 16 * p) as u32);
+                let w_lo = vmovl_u8(vget_low_u8(ctrl));
+                let w_hi = vmovl_u8(vget_high_u8(ctrl));
+                let g0 = vaddq_u32(vmovl_u16(vget_low_u16(w_lo)), bv);
+                let g1 = vaddq_u32(vmovl_u16(vget_high_u16(w_lo)), bv);
+                let g2 = vaddq_u32(vmovl_u16(vget_low_u16(w_hi)), bv);
+                let g3 = vaddq_u32(vmovl_u16(vget_high_u16(w_hi)), bv);
+                vst1q_u32(starts.add(out), g0);
+                vst1q_u32(starts.add(out + 4), g1);
+                vst1q_u32(starts.add(out + 8), g2);
+                vst1q_u32(starts.add(out + 12), g3);
+                // Kind gather: same 0x80-padding zero-fill as PSHUFB.
+                let kv = vqtbl1q_u8(kw, ctrl);
+                vst1q_u8(kinds.add(out), kv);
+            }
+        }
+        m += o4 as usize;
+    }
+    m
+}
+
+/// Contents of this function is in common with the AVX2 implementation
+/// (per-entry scalar walk; the AVX2 vectorization needs VPERMD-shaped
+/// 32-lane permutes that NEON lacks, and the entry loop is not the hot
+/// part of this pass).
+pub(super) unsafe fn build_spans(
+    stage_kind: *const u8,
+    stage_pos: *const u32,
+    m: usize,
+    spans: *mut Span,
+    sig_kinds: *mut u8,
+) -> usize {
+    let sp = spans.cast::<u64>();
+    let mut w = 0usize;
+    let mut j = 0usize;
+
+    while j < m {
+        let k = *stage_kind.add(j);
+        *sp.add(w) = stage_pos.add(j).cast::<u64>().read_unaligned();
+        *sig_kinds.add(w) = k;
+        w += usize::from(!is_trivia_byte(k) || k == tk!(Hashbang));
+        j += 1;
+    }
+
+    w
+}
+
+pub(super) unsafe fn lanes_post(
+    src: &[u8],
+    out_kinds: *const u8,
+    out_spans: *const Span,
+    m: usize,
+    nn: u32,
+    lanes: &mut Lanes,
+) {
+    let mut inv = 0u64;
+    let mut i = 0usize;
+    while i + 8 <= m {
+        let x = out_kinds.add(i).cast::<u64>().read_unaligned();
+        let mut hits = eqm(x, tk!(Number))
+            | eqm(x, tk!(BigInt))
+            | eqm(x, tk!(IdentEscaped))
+            | eqm(x, tk!(PrivateIdentEscaped));
+        inv |= eqm(x, tk!(Invalid));
+        while hits != 0 {
+            emit_value(
+                src,
+                out_kinds,
+                out_spans,
+                i + (hits.trailing_zeros() >> 3) as usize,
+                lanes,
+            );
+            hits &= hits - 1;
+        }
+        i += 8;
+    }
+    let mut inv_dirty = inv != 0;
+    while i < m {
+        let k = *out_kinds.add(i);
+        if k == tk!(Number)
+            || k == tk!(BigInt)
+            || k == tk!(IdentEscaped)
+            || k == tk!(PrivateIdentEscaped)
+        {
+            emit_value(src, out_kinds, out_spans, i, lanes);
+        }
+        inv_dirty |= k == tk!(Invalid);
+        i += 1;
+    }
+    if inv_dirty {
+        invalid_diags(src, out_kinds, out_spans, m, nn, lanes);
+    }
+}
